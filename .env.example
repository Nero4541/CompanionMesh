# Copy to .env and fill in. Never commit .env.

# Must match API_SERVER_KEY in ~/.hermes/.env (enables session continuity
# and long-term memory scoping in Hermes).
HERMES_API_KEY=

# OpenClaw gateway token (gateway.auth.token in openclaw.json)
OPENCLAW_GATEWAY_TOKEN=

# Only for agent.provider: direct
LLM_API_KEY=

# Only if your TTS server requires a key (IRODORI_API_KEY for Irodori-TTS-Server)
TTS_API_KEY=
