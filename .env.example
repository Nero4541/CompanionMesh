# Copy to .env and fill in. Never commit .env.

# Shared token for every client (browser, edge devices, cameras). Required when
# the server listens beyond localhost; generate e.g. with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPANION_TOKEN=

# Admin dashboard (/admin/) and admin API. Leave empty to allow them only from
# this machine; set it to use the dashboard from elsewhere. Keep it different
# from COMPANION_TOKEN.
COMPANION_ADMIN_TOKEN=

# Must match API_SERVER_KEY in ~/.hermes/.env (enables session continuity
# and long-term memory scoping in Hermes).
HERMES_API_KEY=

# OpenClaw gateway token (gateway.auth.token in openclaw.json)
OPENCLAW_GATEWAY_TOKEN=

# Only for agent.provider: direct
LLM_API_KEY=

# Only if your TTS server requires a key (IRODORI_API_KEY for Irodori-TTS-Server)
TTS_API_KEY=

# Only if your vision model endpoint requires a key
VLM_API_KEY=

# IP camera login (Basic or Digest), if the camera asks for one: for `companion camera`
# (or put them in its URL: http://user:pass@host:8080/shot.jpg), and the default names
# for cameras: in the config. Cameras with other logins name their own variables there.
CAMERA_USERNAME=
CAMERA_PASSWORD=

# Hugging Face token, for the gated voice model of the built-in perception engine
# (pyannote/speaker-diarization-community-1; accept its conditions on Hugging Face
# first). Not needed if you download the model yourself. See docs/people.md.
HF_TOKEN=
